# 共有データベース（Neon PostgreSQL など）を使用する場合のみ設定。
# 未設定の場合はローカル SQLite（.data/）を使用します。
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler-xxxx.aws.neon.tech/neondb?sslmode=require

# ローカル開発で環境変数管理者を使う場合
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-10-chars
# ADMIN_NAME=Administrator

# メール送信（Xserver SMTP — 見積書自動送信）
# SMTP_HOST=sv12515.xserver.jp
# SMTP_PORT=465
# SMTP_USER=shapepouch@package-lab.com
# SMTP_PASS=your_mail_password
# SMTP_FROM=shapepouch@package-lab.com
# MAIL_DRY_RUN=false
# Dangerous test-only routing: when set, ALL mailers send to this address instead
# of the requested customer/supplier address. Keep it out of production config.
# MAIL_RECIPIENT_OVERRIDE=kim@kanei-trade.co.jp
# Random secret for signed customer quotation-approval links. Required in production.
# QUOTATION_APPROVAL_SECRET=change-me-to-a-random-64-char-hex-value
# Dedicated secret for film-order external upload/review tokens. Required (32+ chars).
# FILM_EXTERNAL_TOKEN_SECRET=change-me-to-a-random-64-char-hex-value
# FILM_DESIGN_TO=design@package-lab.com
# FILM_PRACTICE_SUPPLIER=arwg22@gmail.com
# Google Drive 直接アップロード（サービスアカウント）
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# または GOOGLE_SA_CLIENT_EMAIL=... / GOOGLE_SA_PRIVATE_KEY=...
# 個人GoogleアカウントのフォルダへはOAuthリフレッシュトークン方式を使用:
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REFRESH_TOKEN=...
# FILM_RECEIVING_FOLDER_ID=1u2iaE15tH5sQ6s39aGzaDet8tdAzgEf_
# FILM_PROOF_FOLDER_ID=1EP8faGx8z-tLUfdpStN74O9-oIuBSO0K
# FILM_SUPPLIER_B_EMAIL=
