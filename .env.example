# 共有データベース（Neon PostgreSQL など）を使用する場合のみ設定。
# 未設定の場合はローカル SQLite（.data/）を使用します。
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler-xxxx.aws.neon.tech/neondb?sslmode=require

# ローカル開発で環境変数管理者を使う場合
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-10-chars
# ADMIN_NAME=Administrator

# フィルム発注ワークフロー（XServer SMTP）
# SMTP_HOST=sv12515.xserver.jp
# SMTP_PORT=465
# SMTP_USER=your-account
# SMTP_PASSWORD=your-password
# MAIL_FROM=your-account
# MAIL_DRY_RUN=false
# FILM_DESIGN_TO=design@package-lab.com
# FILM_PRACTICE_SUPPLIER=arwg22@gmail.com
# Google Drive 直接アップロード（サービスアカウント）
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# または GOOGLE_SA_CLIENT_EMAIL=... / GOOGLE_SA_PRIVATE_KEY=...
# FILM_RECEIVING_FOLDER_ID=1u2iaE15tH5sQ6s39aGzaDet8tdAzgEf_
# FILM_PROOF_FOLDER_ID=1EP8faGx8z-tLUfdpStN74O9-oIuBSO0K
# FILM_SUPPLIER_B_EMAIL=
